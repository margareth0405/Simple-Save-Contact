# Copy values into your shell or systemd EnvironmentFile; Flask does not load this file automatically.
CONTACTHUB_ENV=production
CONTACTHUB_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
CONTACTHUB_TRUSTED_HOSTS=your-ec2-public-ip-or-domain,127.0.0.1,localhost
CONTACTHUB_TIME_ZONE=Asia/Manila
CONTACTHUB_DATABASE=/var/lib/contacthub/contacthub.sqlite3
# Set false only for an HTTP public-IP demo with fictional data; use true behind HTTPS.
CONTACTHUB_SECURE_COOKIE=false
