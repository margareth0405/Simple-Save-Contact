[Unit]
Description=ContactHub Flask application
After=network.target

[Service]
Type=simple
User=contacthub
Group=contacthub
WorkingDirectory=/srv/contacthub
EnvironmentFile=/etc/contacthub/contacthub.env
ExecStart=/srv/contacthub/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - app:app
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/contacthub

[Install]
WantedBy=multi-user.target
